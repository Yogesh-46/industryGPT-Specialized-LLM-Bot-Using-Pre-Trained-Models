# DataPilot AI — environment template
# Copy to .env and fill in values. Never commit .env.

# Hugging Face Hub (optional; required for gated models)
HF_TOKEN=

# Cache directories (useful on Colab / limited disk)
HF_HOME=./.cache/huggingface
TRANSFORMERS_CACHE=./.cache/huggingface/transformers
SENTENCE_TRANSFORMERS_HOME=./.cache/sentence_transformers

# Runtime
DATAPILOT_ENV=development
DATAPILOT_SEED=42
DATAPILOT_DEVICE=auto

# Paths (override defaults from YAML if needed)
DATAPILOT_CONFIG_DIR=./config
DATAPILOT_DATA_DIR=./data
DATAPILOT_KB_DIR=./knowledge_base
DATAPILOT_EXPERIMENTS_DIR=./experiments

# Streamlit
STREAMLIT_SERVER_PORT=8501
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# Collection politeness (seconds between requests)
DATAPILOT_REQUEST_DELAY_SECONDS=1.5
DATAPILOT_USER_AGENT=DataPilotAI-AcademicResearch/0.1 (Masters Project; respectful crawler)
